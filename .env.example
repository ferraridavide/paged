# Google Drive (File → Open from Google Drive / Save to Google Drive).
# Copy to .env.local (git-ignored), fill in, restart `pnpm dev`.
# How to get these values: docs/google-drive.md

# APIs & Services → Credentials → OAuth 2.0 Client IDs (type: Web application)
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# APIs & Services → Credentials → API keys (restricted to the Google Picker API)
VITE_GOOGLE_API_KEY=AIza...

# The Cloud project NUMBER (digits, from the project dashboard), not the project ID
VITE_GOOGLE_APP_ID=1234567890

# Optional: also ask for drive.install, so the app appears in Drive's "Open with" and "New" menus
# (needs the Drive UI integration configured on a public HTTPS URL).
VITE_GOOGLE_DRIVE_INSTALL=false
